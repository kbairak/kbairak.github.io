---
export interface Props {
  title: string;
  description: string;
  repo: string;
  site?: string;
}

const { title, description, repo, site } = Astro.props;
---

<div class="card">
  <h3>{title}</h3>
  <p>{description}</p>
  <p class="links">
    {site && <a href={site}>Site &rarr;</a>}
    {site ? <a href={repo}>Repo &rarr;</a> : <a href={repo}>GitHub &rarr;</a>}
  </p>
</div>

<style>
  .card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    color: var(--fg);
    transition: border-color 0.15s;
  }
  .card:hover { border-color: var(--accent); }
  .card h3 { margin: 0 0 0.35rem; font-size: 1.1rem; }
  .card p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  .links { margin-top: 0.5rem; display: flex; gap: 0.75rem; }
  .links a { font-size: 0.85rem; }
</style>
