---
export interface Props {
  title: string;
  href: string;
  description: string;
}

const { title, href, description } = Astro.props;
---

<a class="card" href={href}>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    color: var(--fg);
    transition: border-color 0.15s;
  }
  .card:hover { border-color: var(--accent); text-decoration: none; }
  .card h3 { margin: 0 0 0.35rem; font-size: 1.1rem; }
  .card p { margin: 0; font-size: 0.9rem; color: var(--muted); }
</style>