---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogList from "../components/BlogList.astro";
import { getCollection } from "astro:content";
import { categories } from "../data/projects";

function slugify(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentPosts = posts.slice(0, 5);
---

<BaseLayout title="kbairak">
  <Nav />

  <section class="hero">
    <h1>Konstantinos Bairaktaris</h1>
    <p class="tagline">Programmer, husband, father of two.</p>
    <p class="links">
      <a href="https://github.com/kbairak">GitHub</a>
      <a href="mailto:ikijob@gmail.com">Email</a>
    </p>
  </section>

  <section>
    <h2>Recent posts</h2>
    <BlogList posts={recentPosts} />
    <p class="all-posts"><a href="/blog">All posts &rarr;</a></p>
  </section>

  <section>
    <h2>Projects</h2>
    {
      categories.map((category) => {
        const slug = slugify(category.name);
        const showMore = category.name !== "Other" && category.projects.length > 2;
        return (
          <>
            <h3>{category.name}</h3>
            <div class="grid">
              {category.projects.slice(0, 2).map((project) => (
                <ProjectCard
                  title={project.title}
                  description={project.description}
                  repo={project.repo}
                  site={project.site}
                />
              ))}
            </div>
            {showMore && <p class="more"><a href={`/projects#${slug}`}>More &rarr;</a></p>}
          </>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 3rem;
  }
  .hero h1 { font-size: 2.5rem; margin: 0 0 0.5rem; }
  .tagline { color: var(--muted); font-size: 1.1rem; margin-bottom: 0.5rem; }
  .links { display: flex; gap: 1rem; }
  .links a { font-size: 0.95rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
  .all-posts { margin-top: 0.5rem; font-size: 0.95rem; }
  h3 { margin-top: 1.5rem; }
  .more { margin: -0.5rem 0 0.5rem; font-size: 0.85rem; }
</style>
