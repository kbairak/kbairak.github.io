---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<BaseLayout title="Projects — kbairak">
  <Nav />
  <h1>Projects</h1>
  <div class="grid">
    <ProjectCard
      title="Space Combat"
      href="https://kbairak.net/spacecombat/"
      description="A space combat game"
    />
    <ProjectCard
      title="Dice"
      href="https://kbairak.net/dice/"
      description="Dice rolling app"
    />
    <ProjectCard
      title="FairBite"
      href="https://kbairak.net/FairBite/"
      description="A Protocol for Fair Food Delivery"
    />
    <ProjectCard
      title="pipepy"
      href="https://github.com/kbairak/pipepy"
      description="Python library for invoking and interacting with shell commands"
    />
    <ProjectCard
      title="ColumnTags.nvim"
      href="https://github.com/kbairak/ColumnTags.nvim"
      description="Miller Columns navigation plugin for Neovim"
    />
    <ProjectCard
      title="webmq"
      href="https://github.com/kbairak/webmq"
      description="Real-time messaging framework with WebSockets and RabbitMQ"
    />
    <ProjectCard
      title="djsonapi"
      href="https://github.com/kbairak/djsonapi"
      description="{json:api} server toolkit for Django"
    />
    <ProjectCard
      title="pjst"
      href="https://github.com/kbairak/pjst"
      description="Python {json:api} Server Toolkit"
    />
    <ProjectCard
      title="ohk"
      href="https://github.com/kbairak/ohk"
      description="Interactive alternative to grep and awk"
    />
  </div>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
</style>